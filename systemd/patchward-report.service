[Unit]
Description=patchward defensive posture report
Documentation=https://github.com/ForexRobotics/patchward
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Read-only: reports findings + attacker IPs + CISA KEV trends. Makes no changes.
ExecStart=/usr/bin/patchward report --trends -o /var/log/patchward/report.html
# Hardening for the unit itself.
ProtectSystem=strict
ReadWritePaths=/var/log/patchward /var/cache/patchward
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
