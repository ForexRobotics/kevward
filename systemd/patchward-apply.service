[Unit]
Description=patchward apply security updates (opt-in)
Documentation=https://github.com/ForexRobotics/patchward
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# CHANGES THE SYSTEM. Enable the paired timer only once you have reviewed a few
# `patchward check` runs and are comfortable with automatic security patching.
# --reboot only takes effect if policy.allow_reboot = true in config.
ExecStart=/usr/bin/patchward apply --yes --reboot
NoNewPrivileges=true
